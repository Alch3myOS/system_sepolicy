typeattribute priv_app coredomain;
app_domain(priv_app)

# Access the network.
net_domain(priv_app)
# Access bluetooth.
bluetooth_domain(priv_app)

# Allow the allocation and use of ptys
# Used by: https://play.privileged.com/store/apps/details?id=jackpal.androidterm
create_pty(priv_app)

# Allow priv-app apps to access metadata_file
allow priv_app metadata_file:file r_file_perms;
allow priv_app metadata_file:dir r_dir_perms;

priv_app_domain(priv_app)
